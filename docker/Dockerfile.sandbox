# Sandbox image used for reproduction attempts. Runs with --network none.
FROM debian:trixie-slim
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential clang libclang-rt-dev gdb valgrind autoconf automake libtool pkg-config cmake make git ccache \
      libssl-dev zlib1g-dev libpsl-dev libnghttp2-dev libbrotli-dev libzstd-dev libgsasl-dev \
      python3 python3-pip python3-venv netcat-openbsd procps file ca-certificates \
      flex bison libyaml-dev libedit-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*
# ccache symlinks so clang/gcc route through ccache when /usr/lib/ccache is on PATH (opt-in, see sandbox.py).
RUN mkdir -p /usr/lib/ccache && for c in clang clang++ gcc g++ cc c++; do ln -sf /usr/bin/ccache /usr/lib/ccache/$c; done
RUN useradd -m -u 1000 runner
USER runner
WORKDIR /work
